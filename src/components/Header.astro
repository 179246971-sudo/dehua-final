---
---
<header style="background:#f9f6f1;">
  <div class="container">
    <div style="position: relative; background:#5c4838; padding:1.5rem 1rem;">
      <div class="header-inner">
        <a href="/" class="brand" aria-label="Dehua Porcelain home">
          <span class="brand-full">Dehua Porcelain</span>
          <span class="brand-short">Dehua</span>
        </a>
        <nav>
          <ul class="nav-list">
            <li><a href="/">Home</a></li>
            <li><a href="/#services">Services</a></li>
            <li><a href="/guidebook">Handbook</a></li>
            <li><a href="/blog">Blog</a></li>
          </ul>
        </nav>
      </div>
    </div>
  </div>
</header>

<style>
  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }

  .brand {
    font-size: 1.3rem;
    font-weight: 600;
    color: #ffffff;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand-short {
    display: none;
  }

  .nav-list {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-list a {
    color: #ffffff;
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .brand {
      font-size: 1.1rem;
    }

    .nav-list {
      gap: 1.15rem;
    }

    .nav-list a {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 560px) {
    .brand-full {
      display: none;
    }

    .brand-short {
      display: inline;
    }

    .brand {
      font-size: 1rem;
    }

    .nav-list {
      gap: 0.85rem;
    }

    .nav-list a {
      font-size: 0.82rem;
    }
  }

  @media (max-width: 380px) {
    .brand {
      font-size: 0.92rem;
    }

    .nav-list {
      gap: 0.6rem;
    }

    .nav-list a {
      font-size: 0.78rem;
    }
  }
</style>
