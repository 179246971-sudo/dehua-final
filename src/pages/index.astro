---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const title = "Dehua Porcelain Sourcing | Custom White Ceramic Supplier";
---
<BaseLayout title={title}>
  <Fragment slot="header">
    <Header />
  </Fragment>
  <div class="container">
    <!-- Banner 修复移动端变形 -->
<section class="banner-wrap" style="margin: 1rem 0; overflow: hidden; position: relative; height: clamp(180px, 30vw, 320px);">
  <img 
    src="https://images.unsplash.com/photo-1565193566173-7a0ee3dbe261?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80" 
    alt="Old craftsman working in ceramic kiln" 
    style="width:100%; height:100%; object-fit:cover; object-position:center; display:block;"
  >
  <div style="
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(40,25,15,0.55) 0%, rgba(40,25,15,0.25) 45%, rgba(40,25,15,0) 100%);
    display: flex;
    align-items: center;
    padding: 0 10%;
  ">
    <h1 style="
      color: #ffffff;
      font-size: clamp(1.4rem, 3vw, 2.4rem);
      font-weight: 600;
      line-height: 1.3;
      text-shadow: 0 2px 10px rgba(0,0,0,0.35);
      max-width: 640px;
    ">
      Your reliable on‑site sourcing partner in Dehua.
    </h1>
  </div>
</section>

    <!-- Services 板块：移除 text‑align:justify，改为默认左对齐，消除英文大单词间隙 -->
<section style="margin: 1rem 0;" id="services">
  <div style="background: var(--white); padding: 2rem;">
    <h2 style="font-size:1.6rem; margin:0 0 1.5rem 0; color: var(--brown-dark);">Our Services</h2>
    <div class="grid-four">
      <div style="background:#f8f5f0; padding:1rem; display:flex; flex-direction:column; height:100%;">
        <h3 style="margin-top:0; font-size:1.1rem;">Sourcing Guidebook</h3>
        <p style="margin:0.5rem 0 0.8rem; font-size:0.95rem; line-height:1.6;">Clear ceramic sourcing guide covering MOQ, mould, glaze, packaging, QC and shipping rules for Dehua porcelain buyers.</p>
        <div style="margin-top:auto;">
          <a href="/guidebook" style="color:var(--brown-dark); font-weight:500; text-decoration:underline;">More</a>
        </div>
      </div>
 <div style="background:#f8f5f0; padding:1rem; display:flex; flex-direction:column; height:100%;">
  <h3 style="margin-top:0; font-size:1.1rem;">Supplier Development</h3>
  <p style="margin:0.5rem 0 0.8rem; font-size:0.95rem; line-height:1.6;">Identify and vet qualified Dehua ceramic manufacturers for your project.</p>
  <div style="margin-top:auto;">
    <a href="/supplier-development" style="color:var(--brown-dark); font-weight:500; text-decoration:underline;">More</a>
  </div>
</div>
      <div style="background:#f8f5f0; padding:1rem; display:flex; flex-direction:column; height:100%;">
        <h3 style="margin-top:0; font-size:1.1rem;">Sample Follow‑up</h3>
        <p style="margin:0.5rem 0 0.8rem; font-size:0.95rem; line-height:1.6;">Work with factories to track sample progress. We check details and send photos before sample dispatch.</p>
        <div style="margin-top:auto;">
          <a href="/sample" style="color:var(--brown-dark); font-weight:500; text-decoration:underline;">More</a>
        </div>
      </div>
      <div style="background:#f8f5f0; padding:1rem; display:flex; flex-direction:column; height:100%;">
        <h3 style="margin-top:0; font-size:1.1rem;">Bulk Order Follow‑up</h3>
        <p style="margin:0.5rem 0 0.8rem; font-size:0.95rem; line-height:1.6;">Manage production timelines, perform in‑process checks and final QC before container loading.</p>
        <div style="margin-top:auto;">
          <a href="/bulk" style="color:var(--brown-dark); font-weight:500; text-decoration:underline;">More</a>
        </div>
      </div>
    </div>
  </div>
</section>

    <!-- About + FAQ + Form 区域 -->
<section style="margin: 1rem 0;" id="faq">
  <div class="about-faq-form-grid">
    <div>
      <!-- About Us -->
      <div style="background: var(--white); padding: 2rem; margin-bottom:2rem;">
        <h2 style="font-size:1.6rem; margin-bottom:1rem;">About Us</h2>
        <p style="line-height:1.7;">As the World Capital of Ceramics, Dehua County boasts one of the most complete porcelain industrial chains in China. Everything you need for custom ceramic goods can be sourced locally here.</p>
        <div id="about-more" style="display:none; margin-top:0.8rem;">
          <p style="line-height:1.7;">We are based in Dehua, which allows us to visit factories face‑to‑face, verify production conditions and solve problems on site. Unlike remote brokers, we can react quickly when unexpected issues arise during sampling or mass production.</p>
          <p style="margin-top:0.8rem; line-height:1.7;">We focus exclusively on ceramic procurement for overseas small and medium buyers. Our goal is to lower your sourcing risk and help you get reliable custom porcelain products with stable quality.</p>
        </div>
        <button id="about-toggle" style="margin-top:1rem; border:none; background:transparent; color:var(--brown-dark); font-weight:500; cursor:pointer; text-decoration:underline;">Read more</button>
        <script>
          const aboutMore = document.getElementById('about-more');
          const aboutBtn = document.getElementById('about-toggle');
          aboutBtn.addEventListener('click', ()=>{
            if(aboutMore.style.display === 'none'){
              aboutMore.style.display = 'block';
              aboutBtn.textContent = 'Read less';
            }else{
              aboutMore.style.display = 'none';
              aboutBtn.textContent = 'Read more';
            }
          })
        </script>
      </div>
      <!-- FAQ：前3条默认仅显示问题，回答收起；点击展开；后2条整体由Read more按钮控制 -->
      <div style="background: var(--white); padding: 2rem;">
        <h2 style="font-size:1.6rem; margin-bottom:1rem;">FAQ</h2>
        <div style="display:flex; flex-direction:column; gap:1rem;">
          <!-- 可见 1：默认收起回答 -->
          <details style="background:#f8f5f0; padding:1rem;">
            <summary style="cursor:pointer; font-weight:500;">What is the typical MOQ for Dehua custom porcelain?</summary>
            <p style="margin-top:0.6rem;">MOQ varies by product. Many white‑porcelain items support small trial orders starting from 300‑500 pcs. For brand‑new mould development, higher quantities will apply. We help you negotiate suitable MOQ with local factories according to your budget.</p>
          </details>
          <!-- 可见 2：默认收起 -->
          <details style="background:#f8f5f0; padding:1rem;">
            <summary style="cursor:pointer; font-weight:500;">How long does sample development take?</summary>
            <p style="margin-top:0.6rem;">Normally 7‑15 working days after design confirmation. Complex shapes or custom glaze colours may require extra time. We track sample progress and send you photos for confirmation before samples are shipped.</p>
          </details>
          <!-- 可见 3：默认收起 -->
          <details style="background:#f8f5f0; padding:1rem;">
            <summary style="cursor:pointer; font-weight:500;">Can I custom‑make logo, glaze colour and product shape?</summary>
            <p style="margin-top:0.6rem;">Yes. Decal logo, embossed logo, custom glaze and new shape moulds are all available. We will check factory feasibility and related costs for your project.</p>
          </details>
          <!-- 折叠容器：第4、5条 默认整体隐藏 -->
          <div id="faq-more-wrap" style="display:flex; flex-direction:column; gap:1rem; display:none;">
            <details style="background:#f8f5f0; padding:1rem;">
              <summary style="cursor:pointer; font-weight:500;">What payment terms do you work with?</summary>
              <p style="margin-top:0.6rem;">We commonly follow T/T terms: deposit before production, and balance before shipment. We do not receive payments ourselves; all payments go directly to the cooperating Dehua factories. Our service fee is separate.</p>
            </details>
            <details style="background:#f8f5f0; padding:1rem;">
              <summary style="cursor:pointer; font-weight:500;">Why should I use your service instead of contacting factories directly?</summary>
              <p style="margin-top:0.6rem;">Most Dehua factories have limited English support. Being on‑site locally, we communicate your requirements face‑to‑face, follow‑up sampling and mass‑production, perform spot checks, and help resolve unexpected production problems for overseas small‑buyers.</p>
            </details>
          </div>
        </div>
        <button id="faq-toggle-btn" style="margin-top:1rem; border:none; background:transparent; color:var(--brown-dark); font-weight:500; cursor:pointer; text-decoration:underline;">Read more</button>
        <script>
          const faqWrap = document.getElementById('faq-more-wrap');
          const faqBtn = document.getElementById('faq-toggle-btn');
          faqBtn.addEventListener('click', ()=>{
            if(faqWrap.style.display === 'none'){
              faqWrap.style.display = 'flex';
              faqBtn.textContent = 'Read less';
            }else{
              faqWrap.style.display = 'none';
              faqBtn.textContent = 'Read more';
            }
          })
        </script>
      </div>
    </div>
    <!-- 表单 -->
    <div style="background: var(--white); padding: 2rem;">
      <h3 style="font-size:1.4rem; margin-bottom:1.2rem;">Share Your Ceramic Project</h3>
      <form id="inquiryForm" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value="你的web3forms_access_key">
        <input type="hidden" name="subject" value="New Ceramic Inquiry">
        <div style="margin-bottom:1rem;">
          <label style="display:block; margin-bottom:0.4rem; font-size:0.9rem;">Name</label>
          <input type="text" name="name" required style="width:100%; padding:0.75rem; border:1px solid var(--border-color); background:#fff;">
        </div>
        <div style="margin-bottom:1rem;">
          <label style="display:block; margin-bottom:0.4rem; font-size:0.9rem;">Email</label>
          <input type="email" name="email" required style="width:100%; padding:0.75rem; border:1px solid var(--border-color); background:#fff;">
        </div>
        <div style="margin-bottom:1rem;">
          <label style="display:block; margin-bottom:0.4rem; font-size:0.9rem;">Project timeline</label>
          <select name="timeline" style="width:100%; padding:0.75rem; border:1px solid var(--border-color); background:#fff;">
            <option>Urgent (within 30 days)</option>
            <option>1–2 months</option>
            <option>2–3 months</option>
            <option>Not sure yet</option>
          </select>
        </div>
        <div style="margin-bottom:1rem;">
          <label style="display:block; margin-bottom:0.4rem; font-size:0.9rem;">How did you find us?</label>
          <select name="source" style="width:100%; padding:0.75rem; border:1px solid var(--border-color); background:#fff;">
            <option>Google Search</option>
            <option>Fiverr</option>
            <option>Social media</option>
            <option>Referral</option>
            <option>Other</option>
          </select>
        </div>
        <div style="margin-bottom:1.2rem;">
          <label style="display:block; margin-bottom:0.4rem; font-size:0.9rem;">Project details</label>
          <textarea name="message" rows="4" required style="width:100%; padding:0.75rem; border:1px solid var(--border-color); background:#fff;"></textarea>
        </div>
        <button type="submit" style="width:100%; padding:0.9rem; background:var(--brown-dark); color:#fff; border:none; font-weight:500; cursor:pointer;">Submit Inquiry</button>
      </form>
      <script>
        const form = document.getElementById('inquiryForm');
        const whatsappNumber = "8613800138000";
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const formData = new FormData(form);
          await fetch(form.action, {
            method: form.method,
            body: formData
          });
          const text = `New Ceramic Inquiry
Name: ${formData.get('name')}
Email: ${formData.get('email')}
Timeline: ${formData.get('timeline')}
Source: ${formData.get('source')}
Message: ${formData.get('message')}`;
          const encodedText = encodeURIComponent(text);
          window.open(`https://wa.me/${whatsappNumber}?text=${encodedText}`, '_blank');
          form.reset();
        })
      </script>
    </div>
  </div>
</section>

<style>
.grid-four {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
}
.about-faq-form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
}
@media (max-width:768px) {
  .grid-four {
    grid-template-columns: 1fr;
  }
  .about-faq-form-grid {
    grid-template-columns: 1fr;
  }
}
</style>
  </div>
  <Fragment slot="footer">
    <Footer />
  </Fragment>
</BaseLayout>
