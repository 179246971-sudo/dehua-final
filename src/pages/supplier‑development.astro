---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const title = "Supplier Development | Dehua Ceramic Sourcing";

// JS脚本块内手写路径，规避复制粘贴隐形字符
const pathBasic = import.meta.env.BASE_URL + "supplier-dev-basic";
const pathStandard = import.meta.env.BASE_URL + "supplier-dev-standard";
const pathPremium = import.meta.env.BASE_URL + "supplier-dev-premium";
---
<BaseLayout title={title}>
  <Fragment slot="header">
    <Header />
  </Fragment>
<div class="container page-supplier-dev" style="padding:2rem 0;">
  <div style="background:var(--white); padding:2rem;">
    <h1 style="font-size:1.8rem; color:var(--brown-dark); margin:0 0 1rem 0;">Supplier Development<br/><span style="font-size:1.2rem; font-weight:normal;">Dehua Ceramic Supplier Sourcing</span></h1>
    <p style="font-size:1rem; line-height:1.7; margin-bottom:2rem;">GIG: Dehua Ceramic Supplier Sourcing</p>

    <section class="service-intro" style="margin-bottom:2.5rem;">
      <h2 style="font-size:1.4rem; color:var(--brown-dark); margin-bottom:1rem;">Service Overview</h2>
      <div style="display:grid; gap:1.5rem;">
        <div style="background:#f8f5f0; padding:1.2rem;">
          <h3 style="margin:0 0 0.6rem 0; font-size:1.1rem;">Intended For</h3>
          <p style="margin:0 0 0.8rem 0; line-height:1.7;">
            Before you invest in sampling and mass production, this service answers the core question: <strong>who should I work with?</strong>. Drawing on our local Dehua network, we screen workshops against your product specs, materials, dimensions and budget. We verify real‑world production capacity, cost structures and potential risks, and deliver actionable supplier profiles. The core goal is to <strong>minimize your trial‑and‑error cost of picking the wrong factory up‑front.</strong>
          </p>
          <ul style="margin:0; padding-left:1.4rem; line-height:1.7;">
            <li>Overseas buyers new to Dehua ceramic supply chain with no local factory contacts or language barriers</li>
            <li>Buyers with drawings or physical samples, unsure whether to engage prototype‑focused or mass‑production workshops</li>
            <li>Mid‑size B‑buyers building a qualified supplier pool for long‑term cooperation before placing formal orders</li>
            <li>Buyers burned by hidden extra costs after receiving low initial factory quotations</li>
          </ul>
        </div>
        <div style="background:#f8f5f0; padding:1.2rem;">
          <h3 style="margin:0 0 0.6rem 0; font-size:1.1rem;">Important Notes</h3>
          <ul style="margin:0; padding-left:1.4rem; line-height:1.7;">
            <li><strong>Service boundary:</strong> Service concludes upon delivery of supplier profiles. Sampling coordination, mold opening, mass‑order follow‑up, inspection, shipment arrangement, production guarantee and quality / lead‑time commitments are not included. These can be purchased separately via Sampling Service or Order Follow‑up Service.</li>
            <li>RFQ results are preliminary quotations only, not formal PI pricing. Final pricing is subject to factory official quotation after sample confirmation.</li>
            <li>Listed pricing applies to one single product line. Separate quotation required for multi‑category, cross‑region or highly‑special craftsmanship projects.</li>
            <li>Recommendation: Choose Basic for general market exploration. If you have clear drawings and plan for sampling / long‑term cooperation, Standard or Premium is preferred. Mold ownership, mold revision and glaze‑related risk points are only covered starting from Standard tier.</li>
            <li>All plans are one‑time service fees completely separate from goods payment. We do not collect or hold factory payments on your behalf.</li>
          </ul>
        </div>
      </div>
    </section>

    <section style="margin-bottom:2.5rem;">
      <h2 style="font-size:1.4rem; color:var(--brown-dark); margin-bottom:1rem;">Plan Comparison</h2>
      <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse; min-width:640px;">
          <thead>
            <tr style="background:#f8f5f0;">
              <th style="border:1px solid var(--border-color); padding:0.8rem; text-align:left;">Plan</th>
              <th style="border:1px solid var(--border-color); padding:0.8rem; text-align:left;">Price (USD)</th>
              <th style="border:1px solid var(--border-color); padding:0.8rem; text-align:left;">Key Deliverables</th>
              <th style="border:1px solid var(--border-color); padding:0.8rem; text-align:left;">Scope of Work</th>
              <th style="border:1px solid var(--border-color); padding:0.8rem; text-align:left;">Not Included</th>
              <th style="border:1px solid var(--border-color); padding:0.8rem; text-align:center;">Sample Output</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td style="border:1px solid var(--border-color); padding:0.8rem;"><strong>Basic</strong></td>
              <td style="border:1px solid var(--border-color); padding:0.8rem;">$75</td>
              <td style="border:1px solid var(--border-color); padding:0.8rem;">Shortlist of 3 matched workshops; basic RFQ summary; contact info; mark prototype / mass‑production workshop type</td>
              <td style="border:1px solid var(--border-color); padding:0.8rem;">Source and match candidates; basic inquiry for MOQ, sample cost & lead‑time. You may contact factories directly after delivery.</td>
              <td style="border:1px solid var(--border-color); padding:0.8rem;">On‑site footage; outsourcing risk assessment; deep mold‑ownership verification; yield evaluation; contract‑term review</td>
              <td style="border:1px solid var(--border-color); padding:0.8rem; text-align:center;">
                <a href={pathBasic} style="color:var(--brown-dark); text-decoration:underline;">View Sample ⓘ</a>
              </td>
            </tr>
            <tr style="background:#fdfaf5;">
              <td style="border:1px solid var(--border-color); padding:0.8rem;"><strong>Standard (Recommended)</strong></td>
              <td style="border:1px solid var(--border-color); padding:0.8rem;">$145</td>
              <td style="border:1px solid var(--border-color); padding:0.8rem;">All Basic deliverables + deep RFQ clarification; hidden‑cost breakdown; basic qualification check; preliminary risk notes</td>
              <td style="border:1px solid var(--border-color); padding:0.8rem;">Clarify hidden costs; evaluate workshop suitability; deliver structured comparison sheet</td>
              <td style="border:1px solid var(--border-color); padding:0.8rem;">Factory tour video; deep outsourcing‑chain audit; long‑term yield stability evaluation</td>
              <td style="border:1px solid var(--border-color); padding:0.8rem; text-align:center;">
                <a href={pathStandard} style="color:var(--brown-dark); text-decoration:underline;">View Sample ⓘ</a>
              </td>
            </tr>
            <tr>
              <td style="border:1px solid var(--border-color); padding:0.8rem;"><strong>Premium</strong></td>
              <td style="border:1px solid var(--border-color); padding:0.8rem;">$220</td>
              <td style="border:1px solid var(--border-color); padding:0.8rem;">All Standard deliverables + factory photos & tour clips; outsourcing‑dependency assessment; mold‑practice notes; yield / seasonal‑risk analysis; full due‑diligence report</td>
              <td style="border:1px solid var(--border-color); padding:0.8rem;">Neutral deep due‑diligence; cross‑evaluate mass‑production risks; deliver inputs for long‑term cooperation decisions</td>
              <td style="border:1px solid var(--border-color); padding:0.8rem;">Sample development, mold opening, production guarantee, quality / lead‑time commitments (excluded across all tiers)</td>
              <td style="border:1px solid var(--border-color); padding:0.8rem; text-align:center;">
                <a href={pathPremium} style="color:var(--brown-dark); text-decoration:underline;">View Sample ⓘ</a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <p style="font-size:0.85rem; color:#444; margin-top:0.6rem;">Note: For Basic / Standard, “Not Included” lists items available only in higher tiers. For Premium, “Not Included” lists items never covered by this service.</p>
    </section>

    <div style="background:#f8f5f0; padding:1.4rem; text-align:center;">
      <h3 style="margin-top:0; color:var(--brown-dark);">Ready to start your sourcing project?</h3>
      <p style="margin-bottom:1rem;">Submit your project requirements and we will assess your best‑fit solution.</p>
      <a href="/#faq" style="display:inline-block; padding:0.8rem 1.6rem; background:var(--brown-dark); color:white; text-decoration:none;">Go to Project Inquiry Form</a>
    </div>
  </div>
</div>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</BaseLayout>

<style>
.page-supplier-dev table td,
.page-supplier-dev table th {
  font-size:0.92rem;
}
</style>
