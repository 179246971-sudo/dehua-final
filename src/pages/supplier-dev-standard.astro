---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const title = "Standard Plan Sample | Supplier Development";
---
<BaseLayout title={title}>
  <Fragment slot="header"><Header /></Fragment>
<div class="container" style="padding:2rem 1rem;">
  <div style="background:var(--white); padding:2rem;">
    <h1 style="font-size:1.6rem; color:var(--brown-dark); margin:0 0 1rem 0;">Standard｜Supplier Profile Sample</h1>
    <p style="font-size:0.85rem; color:#666;"><em>Sample only for format reference. Real supplier data depends on your project.</em></p>
    <div style="overflow-x:auto; margin:1.2rem 0;">
<table style="width:100%; border-collapse:collapse; min-width:520px;">
<tbody>
<tr><td colspan="2" style="background:#f8f5f0; font-weight:bold; padding:0.7rem; border:1px solid #ccc;">1. Basic Information</td></tr>
<tr><td style="padding:0.6rem; border:1px solid #ccc; width:38%;">Workshop Name</td><td style="padding:0.6rem; border:1px solid #ccc;">Dehua XX Ceramic Workshop</td></tr>
<tr><td style="padding:0.6rem; border:1px solid #ccc;">Location</td><td style="padding:0.6rem; border:1px solid #ccc;">Dehua, Quanzhou, Fujian</td></tr>
<tr><td style="padding:0.6rem; border:1px solid #ccc;">Contact Person</td><td style="padding:0.6rem; border:1px solid #ccc;">Mr. Lin</td></tr>
<tr><td style="padding:0.6rem; border:1px solid #ccc;">Contact</td><td style="padding:0.6rem; border:1px solid #ccc;">138****8888</td></tr>

<tr><td colspan="2" style="background:#f8f5f0; font-weight:bold; padding:0.7rem; border:1px solid #ccc;">2. Workshop Type & Capacity</td></tr>
<tr><td style="padding:0.6rem; border:1px solid #ccc;">Workshop Type</td><td style="padding:0.6rem; border:1px solid #ccc;">Small‑batch mass‑production workshop</td></tr>
<tr><td style="padding:0.6rem; border:1px solid #ccc;">Main Product Range</td><td style="padding:0.6rem; border:1px solid #ccc;">Daily‑use white‑ceramic cups & tableware</td></tr>
<tr><td style="padding:0.6rem; border:1px solid #ccc;">Typical MOQ</td><td style="padding:0.6rem; border:1px solid #ccc;">500 pcs</td></tr>
<tr><td style="padding:0.6rem; border:1px solid #ccc;">Sample Lead‑time</td><td style="padding:0.6rem; border:1px solid #ccc;">7‑10 working days</td></tr>
<tr><td style="padding:0.6rem; border:1px solid #ccc;">Mass‑order Lead‑time</td><td style="padding:0.6rem; border:1px solid #ccc;">25‑35 days</td></tr>
<tr><td style="padding:0.6rem; border:1px solid #ccc;">Typical Payment Terms</td><td style="padding:0.6rem; border:1px solid #ccc;">30% deposit before production</td></tr>

<tr><td colspan="2" style="background:#f8f5f0; font-weight:bold; padding:0.7rem; border:1px solid #ccc;">3. Process Capability</td></tr>
<tr><td style="padding:0.6rem; border:1px solid #ccc;">Core Processes</td><td style="padding:0.6rem; border:1px solid #ccc;">Slip casting, matte glaze</td></tr>
<tr><td style="padding:0.6rem; border:1px solid #ccc;">Surface Treatments</td><td style="padding:0.6rem; border:1px solid #ccc;">Decal printing, bisque firing</td></tr>
<tr><td style="padding:0.6rem; border:1px solid #ccc;">In‑house Mold Shop</td><td style="padding:0.6rem; border:1px solid #ccc;">Yes</td></tr>
<tr><td style="padding:0.6rem; border:1px solid #ccc;">Outsourcing Notes</td><td style="padding:0.6rem; border:1px solid #ccc;">No critical outsourced steps</td></tr>

<tr><td colspan="2" style="background:#f8f5f0; font-weight:bold; padding:0.7rem; border:1px solid #ccc;">4. Compliance & Qualification</td></tr>
<tr><td style="padding:0.6rem; border:1px solid #ccc;">Testing Support</td><td style="padding:0.6rem; border:1px solid #ccc;">FDA / LFGB testing available</td></tr>
<tr><td style="padding:0.6rem; border:1px solid #ccc;">Similar‑product Experience</td><td style="padding:0.6rem; border:1px solid #ccc;">Solid track‑record for overseas daily‑use white‑ceramic orders</td></tr>

<tr><td colspan="2" style="background:#f8f5f0; font-weight:bold; padding:0.7rem; border:1px solid #ccc;">5. Quotation & Cost Breakdown</td></tr>
<tr><td style="padding:0.6rem; border:1px solid #ccc;">Base unit price range</td><td style="padding:0.6rem; border:1px solid #ccc;">$1.4‑1.8 /pc</td></tr>
<tr><td style="padding:0.6rem; border:1px solid #ccc;">Mold‑open / modification fee</td><td style="padding:0.6rem; border:1px solid #ccc;">Mold‑open $280; modification $80‑120</td></tr>
<tr><td style="padding:0.6rem; border:1px solid #ccc;">Hidden‑cost Remarks</td><td style="padding:0.6rem; border:1px solid #ccc;">Color‑printed gift boxes will add extra cost</td></tr>
</tbody>
</table>
    </div>
    <p style="font-size:0.85rem;"><strong>Note:</strong> Standard tier does not include full yield assessment, seasonal‑risk analysis or factory‑tour attachments.</p>
    <div style="margin-top:2rem;">
      <a href="/supplier-development" style="color:var(--brown-dark); text-decoration:underline;">← Back to Plans &amp; Pricing</a>
    </div>
  </div>
</div>
  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>
