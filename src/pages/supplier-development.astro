---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const title = "Supplier Development | Dehua Ceramic Sourcing";

// JS脚本块内手写路径，规避复制粘贴隐形字符
const pathBasic = import.meta.env.BASE_URL + "supplier-dev-basic";
const pathStandard = import.meta.env.BASE_URL + "supplier-dev-standard";
const pathPremium = import.meta.env.BASE_URL + "supplier-dev-premium";
---
<BaseLayout title={title}>
  <Fragment slot="header">
    <Header />
  </Fragment>
<div class="container page-supplier-dev" style="padding:2rem 1rem;">
  <div style="background:var(--white); padding:2rem;">
    <h1 style="font-size:1.8rem; color:var(--brown-dark); margin:0 0 2rem 0;">Supplier Development</h1>

    <section class="service-intro" style="margin-bottom:2.5rem;">
      <div style="background:#f8f5f0; padding:1.2rem;">
        <h3 style="margin:0 0 0.6rem 0; font-size:1.1rem;">Intended For</h3>
        <ul style="margin:0; padding-left:1.4rem; line-height:1.7;">
          <li>Overseas buyers new to Dehua ceramic supply chain with no local factory contacts or language barriers</li>
          <li>Buyers with drawings or physical samples, unsure whether to engage prototype‑focused or mass‑production workshops</li>
          <li>Mid‑size B‑buyers building a qualified supplier pool for long‑term cooperation before placing formal orders</li>
          <li>Buyers burned by hidden extra costs after receiving low initial factory quotations</li>
        </ul>
      </div>
    </section>

    <section style="margin-bottom:2.5rem;">
      <h2 style="font-size:1.4rem; color:var(--brown-dark); margin-bottom:1rem;">Plans &amp; Pricing</h2>
      <p style="margin:0 0 1rem 0; color:#444;">Not sure which tier? Basic fits market exploration. Choose Standard or Premium if you already have drawings and plan to sample or work long‑term.</p>
      <div class="plan-scroll-wrap">
        <div class="plan-scroll">
          <table class="plan-table" style="width:100%; border-collapse:collapse; min-width:640px;">
          <thead>
            <tr style="background:#f8f5f0;">
              <th style="border:1px solid var(--border-color); padding:0.8rem; text-align:left;">Plan</th>
              <th style="border:1px solid var(--border-color); padding:0.8rem; text-align:left;">Price (USD)</th>
              <th style="border:1px solid var(--border-color); padding:0.8rem; text-align:left;">Key Deliverables</th>
              <th style="border:1px solid var(--border-color); padding:0.8rem; text-align:left;">Scope of Work</th>
              <th style="border:1px solid var(--border-color); padding:0.8rem; text-align:center;">Sample Output</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td style="border:1px solid var(--border-color); padding:0.8rem;"><strong>Basic</strong></td>
              <td style="border:1px solid var(--border-color); padding:0.8rem;">$75</td>
              <td style="border:1px solid var(--border-color); padding:0.8rem;"><ul class="cell-list"><li>Shortlist of 3 matched workshops</li><li>Basic RFQ summary</li><li>Contact info</li><li>Mark prototype / mass‑production workshop type</li></ul></td>
              <td style="border:1px solid var(--border-color); padding:0.8rem;"><ul class="cell-list"><li>Source and match candidates</li><li>Basic inquiry for MOQ, sample cost & lead‑time.</li><li>You may contact factories directly after delivery.</li></ul></td>
              <td style="border:1px solid var(--border-color); padding:0.8rem; text-align:center;">
                <a href={pathBasic} style="color:var(--brown-dark); text-decoration:underline;">View Sample ⓘ</a>
              </td>
            </tr>
            <tr style="background:#fdfaf5;">
              <td style="border:1px solid var(--border-color); padding:0.8rem;"><strong>Standard</strong></td>
              <td style="border:1px solid var(--border-color); padding:0.8rem;">$145</td>
              <td style="border:1px solid var(--border-color); padding:0.8rem;"><ul class="cell-list"><li>All Basic deliverables + deep RFQ clarification</li><li>Hidden‑cost breakdown</li><li>Basic qualification check</li><li>Preliminary risk notes</li></ul></td>
              <td style="border:1px solid var(--border-color); padding:0.8rem;"><ul class="cell-list"><li>Clarify hidden costs</li><li>Evaluate workshop suitability</li><li>Deliver structured comparison sheet</li></ul></td>
              <td style="border:1px solid var(--border-color); padding:0.8rem; text-align:center;">
                <a href={pathStandard} style="color:var(--brown-dark); text-decoration:underline;">View Sample ⓘ</a>
              </td>
            </tr>
            <tr>
              <td style="border:1px solid var(--border-color); padding:0.8rem;"><strong>Premium</strong></td>
              <td style="border:1px solid var(--border-color); padding:0.8rem;">$220</td>
              <td style="border:1px solid var(--border-color); padding:0.8rem;"><ul class="cell-list"><li>All Standard deliverables + factory photos & tour clips</li><li>Outsourcing‑dependency assessment</li><li>Mold‑practice notes</li><li>Yield / seasonal‑risk analysis</li><li>Full due‑diligence report</li></ul></td>
              <td style="border:1px solid var(--border-color); padding:0.8rem;"><ul class="cell-list"><li>Neutral deep due‑diligence</li><li>Cross‑evaluate mass‑production risks</li><li>Deliver inputs for long‑term cooperation decisions</li></ul></td>
              <td style="border:1px solid var(--border-color); padding:0.8rem; text-align:center;">
                <a href={pathPremium} style="color:var(--brown-dark); text-decoration:underline;">View Sample ⓘ</a>
              </td>
            </tr>
          </tbody>
        </table>
        </div>
      </div>
      <p class="swipe-hint">Swipe sideways to see all columns →</p>
    </section>

    <div style="background:#f8f5f0; padding:1.2rem; margin-bottom:2rem;">
      <p style="margin:0; line-height:1.65;"><strong>Scope ends at supplier profiles.</strong> Sampling, mold opening, mass‑order follow‑up, inspection and shipment are not included. These are available separately through our Sampling Service and Order Follow‑up Service.</p>
    </div>

    <div style="background:#f8f5f0; padding:1.4rem; text-align:center;">
      <h3 style="margin-top:0; color:var(--brown-dark);">Ready to start your sourcing project?</h3>
      <p style="margin-bottom:1rem;">Submit your project requirements and we will assess your best‑fit solution.</p>
      <a href="/#faq" style="display:inline-block; padding:0.8rem 1.6rem; background:var(--brown-dark); color:white; text-decoration:none;">Go to Project Inquiry Form</a>
    </div>

    <details style="margin-top:1.5rem; background:#f8f5f0; padding:1.2rem;">
      <summary style="cursor:pointer; font-weight:700; color:var(--brown-dark);">Quotation &amp; payment details</summary>
      <ul style="margin:0.8rem 0 0 0; padding-left:1.4rem; line-height:1.7; font-size:0.92rem;">
        <li>RFQ results are preliminary quotations only. Final pricing follows the factory&#39;s official quotation after sample confirmation.</li>
        <li>Listed pricing covers one single product line. Multi‑category, cross‑region or special‑craft projects require a separate quotation.</li>
        <li>Service fees are one‑time and fully separate from goods payment. We do not collect or hold factory payments on your behalf.</li>
      </ul>
    </details>
  </div>
</div>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</BaseLayout>

<style>
.page-supplier-dev table td,
.page-supplier-dev table th {
  font-size:0.92rem;
}

/* ---------- 移动端优化：首列吸附 + 右侧渐隐 + 价格强调 ---------- */

.plan-scroll-wrap {
  position: relative;
}

.plan-scroll {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

/* 首列吸附：横滑时始终看得见在比哪个套餐 */
.plan-table th:first-child,
.plan-table td:first-child {
  position: sticky;
  left: 0;
  z-index: 2;
  background: #ffffff;
  box-shadow: 4px 0 6px -4px rgba(92, 72, 56, 0.35);
}

.plan-table thead th:first-child {
  background: #f8f5f0;
}

/* Standard 那行原本是浅色底，首列跟着一起变，避免滑动时出现色块断层 */
.plan-table tbody tr:nth-child(2) td:first-child {
  background: #fdfaf5;
}

/* 价格列强调：第一眼抓 $75 / $145 / $220 */
.plan-table td:nth-child(2) {
  font-weight: 700;
  font-size: 1.05rem;
  color: var(--brown-dark);
  white-space: nowrap;
}

/* 单元格内的项目符号列表 */
.cell-list {
  margin: 0;
  padding-left: 1rem;
}

.cell-list li {
  margin-bottom: 0.3rem;
  line-height: 1.5;
}

.cell-list li:last-child {
  margin-bottom: 0;
}

/* 滑动提示：默认隐藏，只在手机上显示 */
.swipe-hint {
  display: none;
}

@media (max-width: 768px) {
  .swipe-hint {
    display: block;
    margin: 0.5rem 0 0 0;
    font-size: 0.8rem;
    color: #7a6a5c;
    text-align: right;
  }

  /* 右侧渐隐，暗示右边还有内容 */
  .plan-scroll-wrap::after {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    width: 28px;
    height: 100%;
    pointer-events: none;
    background: linear-gradient(to right, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.92));
  }

  /* 手机上收紧单元格内边距，一屏能看到更多列 */
  .plan-table th,
  .plan-table td {
    padding: 0.55rem !important;
  }
}
</style>
