---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const title = "Page Not Found | Dehua Porcelain Sourcing";
---
<BaseLayout title={title}>
  <Fragment slot="header"><Header /></Fragment>
<div class="container" style="padding:2rem 1rem;">
  <div style="background:var(--white); padding:2rem; text-align:center;">
    <h1 style="font-size:1.6rem; color:var(--brown-dark); margin:0 0 1rem 0;">Page Not Found</h1>
    <p style="margin:0 0 1.4rem 0;">The page you are looking for doesn&#39;t exist or has been moved.</p>
    <a href="/" style="display:inline-block; padding:0.8rem 1.6rem; background:var(--brown-dark); color:white; text-decoration:none;">Back to Home</a>
  </div>
</div>
  <Fragment slot="footer">
    <Footer />
  </Fragment>
</BaseLayout>
