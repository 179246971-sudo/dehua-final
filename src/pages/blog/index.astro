---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = "Notes from Dehua | Dehua White Porcelain Sourcing";
const description = "Working notes on Dehua white porcelain — reading a quotation, mould ownership, defect grading, and what actually happens on this street.";

const posts = [
  {
    href: "/blog/reading-a-dehua-quotation",
    date: "November 2026",
    tag: "Costs",
    title: "How to read a Dehua quotation without overpaying",
    excerpt:
      "Most workshops here quote one bundled number. Here is the four-part structure to ask for instead, and the four extras that reappear on almost every quotation in this county.",
  },
];

const upcoming = [
  { tag: "Tooling", title: "The mould you paid for is not automatically yours" },
  { tag: "Quality", title: "A, B, C: grading a fired batch in twenty minutes" },
];
---
<BaseLayout title={title} description={description}>
  <Fragment slot="header">
    <Header />
  </Fragment>

  <div class="container blog-page">

    <header class="blog-head">
      <p class="eyebrow">Notes from Dehua</p>
      <h1>What actually happens on this street</h1>
      <p class="lede">
        Short, practical notes written for overseas buyers of custom white porcelain — the parts that
        don't make it into a factory brochure.
      </p>
    </header>

    <section class="post-list">
      {posts.map((post) => (
        <a class="post-card" href={post.href}>
          <div class="post-meta">
            <span class="post-tag">{post.tag}</span>
            <span class="post-date">{post.date}</span>
          </div>
          <h2>{post.title}</h2>
          <p>{post.excerpt}</p>
          <span class="post-more">Read the note</span>
        </a>
      ))}
    </section>

    <section class="upcoming">
      <h2 class="upcoming-title">In the works</h2>
      <ul>
        {upcoming.map((item) => (
          <li>
            <span class="post-tag">{item.tag}</span>
            <span>{item.title}</span>
          </li>
        ))}
      </ul>
      <p class="upcoming-note">Notes are written as orders come in, not on a publishing schedule.</p>
    </section>

    <section class="blog-cta">
      <div>
        <h2>The whole method, in one file</h2>
        <p>Seven parts, sixteen forms, two free chapters — the Handbook collects what these notes are drawn from.</p>
      </div>
      <a class="cta-btn" href="/guidebook">See the Handbook — $39.99</a>
    </section>

  </div>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</BaseLayout>

<style>
  .blog-page {
    --ink: #5c4838;
    --tint: #f8f5f0;
    --line: #d6cdc4;
    padding: 2.5rem 1rem 3rem;
    max-width: 820px;
    margin: 0 auto;
  }

  .blog-head {
    margin-bottom: 2rem;
  }

  .eyebrow {
    margin: 0 0 0.5rem 0;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.72rem;
    font-weight: 600;
    color: #8a7462;
  }

  .blog-head h1 {
    font-size: 1.85rem;
    line-height: 1.3;
    margin: 0 0 0.7rem 0;
    color: var(--ink);
  }

  .lede {
    margin: 0;
    font-size: 0.96rem;
    line-height: 1.7;
    color: #4b4239;
    max-width: 58ch;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .post-card {
    display: block;
    background: var(--tint);
    padding: 1.4rem 1.5rem;
    text-decoration: none;
    color: var(--ink);
    border-left: 3px solid var(--ink);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.55rem;
  }

  .post-tag {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    background: var(--ink);
    color: #ffffff;
    padding: 0.2rem 0.45rem;
  }

  .post-date {
    font-size: 0.76rem;
    color: #8a7462;
  }

  .post-card h2 {
    margin: 0 0 0.5rem 0;
    font-size: 1.18rem;
    line-height: 1.4;
  }

  .post-card p {
    margin: 0 0 0.7rem 0;
    font-size: 0.9rem;
    line-height: 1.68;
    color: #4b4239;
  }

  .post-more {
    font-size: 0.84rem;
    font-weight: 500;
    text-decoration: underline;
  }

  .upcoming {
    margin-top: 2.2rem;
    border-top: 1px solid var(--line);
    padding-top: 1.4rem;
  }

  .upcoming-title {
    font-size: 1rem;
    margin: 0 0 0.8rem 0;
    color: var(--ink);
  }

  .upcoming ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .upcoming li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: #6b5d50;
  }

  .upcoming li .post-tag {
    background: #d6cdc4;
    color: #5c4838;
  }

  .upcoming-note {
    margin: 0.9rem 0 0 0;
    font-size: 0.8rem;
    color: #8a7462;
    font-style: italic;
  }

  .blog-cta {
    margin-top: 2.4rem;
    background: var(--ink);
    color: #ffffff;
    padding: 1.6rem 1.6rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .blog-cta h2 {
    margin: 0 0 0.35rem 0;
    font-size: 1.15rem;
  }

  .blog-cta p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.6;
    color: #e6d9c9;
    max-width: 46ch;
  }

  .cta-btn {
    display: inline-block;
    background: #f7f1e9;
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.75rem 1.1rem;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .blog-page {
      padding: 1.8rem 1rem 2.5rem;
    }

    .blog-head h1 {
      font-size: 1.45rem;
    }

    .post-card {
      padding: 1.15rem 1.15rem;
    }

    .blog-cta {
      padding: 1.3rem 1.2rem;
    }

    .cta-btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
