---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Sourcing Guidebook | Dehua White Porcelain Sourcing Handbook";
const description = "A 74-page sourcing handbook for overseas buyers of custom Dehua white porcelain: mould ownership, quotation breakdown, defect grading, production checkpoints and 16 ready-to-use forms.";

// 结账链接就位后只改这一行：填上独立站结账地址 / 数字商品平台付款页，全页按钮自动切换
// 注意：不要填 paypal.me 链接。PayPal.Me 在中国区个人账户上是 P2P 转账（Friends & Family），
// 页面只有「Send」，没有「Paying for an item or service」，用它收货款属违规用途。
const CHECKOUT_URL = "";

// 备用路径：若 CHECKOUT_URL 被清空，按钮退回页内下单区，用邮件联系
const ORDER_EMAIL = "hello@dehuasourcing.com";
const ORDER_MAILTO = "mailto:" + ORDER_EMAIL + "?subject=Handbook%20order%20-%20%2439.99&body=I%20would%20like%20to%20order%20the%20Dehua%20White%20Porcelain%20Sourcing%20Handbook%20(English%20edition%2C%20PDF).%0A%0ASend%20the%20PDF%20to%3A%20%0AName%2Fcompany%3A%20%0ACountry%3A%20%0A";
const ctaHref = CHECKOUT_URL || "#get";
const buyHref = CHECKOUT_URL || ORDER_MAILTO;
const ctaLabel = CHECKOUT_URL ? "Get the handbook — $39.99" : "How to order — $39.99";

const coverImage = "/images/guidebook/finished-pieces.jpg";
const photos = [
  { src: "/images/guidebook/master-model.jpg", caption: "Master model" },
  { src: "/images/guidebook/working-moulds.jpg", caption: "Working moulds" },
  { src: "/images/guidebook/slip-casting.jpg", caption: "Slip casting" },
  { src: "/images/guidebook/trimming.jpg", caption: "Trimming" },
  { src: "/images/guidebook/glazing.jpg", caption: "Glazing" },
  { src: "/images/guidebook/kiln.jpg", caption: "Kiln" },
];

const parts = [
  {
    label: "Part 1 — Foundations",
    summary: "What Dehua actually is, and what the white body can and cannot do.",
    points: [
      "Ivory white, high white and ordinary white; glossy, matte and satin — and why a matte workshop is not automatically a glossy workshop.",
      "The seven steps from file to fired piece, so you can see where the money and the days go.",
      "Natural tolerance: 10–15% firing shrinkage, batch-to-batch colour shift, pinholes. Normal variation, not defects.",
      "Stock item, modification or a brand-new mould — and which workshop type each one needs.",
    ],
  },
  {
    label: "Part 2 — Supplier evaluation",
    summary: "Telling a prototype studio from a volume factory, before you send money.",
    points: [
      "Three workshop types in Dehua, the order each one is right for, and the honest limit of each.",
      "An eight-field desk check: main category, in-house equipment, MOQ, mould fee and ownership, lead time, secondary processes, QC standard, invoicing and export paperwork.",
      "Sample evaluation, and the order in which to walk a workshop on video: printing room, mould room, casting, trimming, glaze, kiln, QC.",
      "Supplier grading and a working pool of two to three alternatives.",
    ],
  },
  {
    label: "Part 3 — Design and cultural compliance",
    summary: "The check that has to happen before the mould is cut.",
    points: [
      "Region-by-region red lines for the EU, North America, the Middle East and South-East Asia — symbols, religious text, silhouettes and imagery.",
      "Why text is the highest-risk element, and why machine translation is not a check.",
      "Silhouette risk: a shape can be read as a symbol before anyone looks at the drawing.",
      "Copyright and cultural-appropriation exposure, plus a self-check list you can run in ten minutes.",
    ],
  },
  {
    label: "Part 4 — Fulfilment and quality control",
    summary: "Seven points to put in writing, four checkpoints, one grading language.",
    points: [
      "What goes into the order confirmation: forming method, glaze standard, dimensional tolerance, engraving spec, packing, milestone dates, defect rules.",
      "Four checkpoints: moulds ready, first article, bisque, glaze-fired batch.",
      "Defect grading A / B / C and the sampling rules that go with it.",
      "Dehua-specific risks: shared kilns, glaze batch shift, mould wear, silent subcontracting.",
    ],
  },
  {
    label: "Part 5 — Counterparty due diligence",
    summary: "Direct producer, single-process shop, broker, or licensed factory.",
    points: [
      "How to tell a trading middleman from the workshop that actually makes the piece.",
      "Capacity verification: in-house versus subcontracted processes, and who carries the quality.",
      "Contract and order-document points that hold up in a dispute.",
      "Money flow: deposit size, balance only after inspection, and the receiving account you must not use.",
    ],
  },
  {
    label: "Part 6 — Disputes and evidence",
    summary: "What to keep from day one, and how to escalate without shouting.",
    points: [
      "The evidence file to build per order, starting at the first message.",
      "Three escalation levels: interpretation gap, breach, bad faith.",
      "Six recurring disputes — colour, grading, delay, mould ownership, subcontracting, transit damage — with the clause each one turns on.",
      "Which claims are realistically recoverable, and which are not.",
    ],
  },
  {
    label: "Part 7 — Close-out and long-term suppliers",
    summary: "Closing an order properly is what makes the second order cheaper.",
    points: [
      "Close-out actions: settlement wording, archive, samples, moulds, after-sales window.",
      "A supplier file that updates after every order.",
      "A 40 / 25 / 20 / 15 performance scorecard, so the ranking is arithmetic instead of mood.",
      "Elimination triggers and the replacement pool.",
    ],
  },
  {
    label: "Final chapter and appendix",
    summary: "A six-block action checklist, plus the sixteen forms themselves.",
    points: [
      "Six blocks: preparation, sourcing, sampling, contract and production, inspection and shipping, long-term maintenance.",
      "Sixteen forms, ready to print or fill in and send to a workshop.",
      "Every form is cross-referenced to the part of the book that explains it.",
    ],
  },
];

const forms = [
  "RFQ sheet",
  "Sample confirmation",
  "Mould ownership agreement",
  "Bulk order checklist",
  "Project brief",
  "Supplier profile card",
  "Supplier comparison scorecard",
  "Mould register",
  "Production tracker",
  "Inspection checklist",
  "Payment log",
  "Dispute log",
  "Supplier performance review",
  "Compliance test tracker",
  "Packaging confirmation",
  "Dispute scripts",
];

const faqs = [
  {
    q: "What exactly do I receive?",
    a: "A PDF handbook in English, 74 pages, set in a 6 × 9 inch page — the size ebooks are usually read at, not an A4 office printout. It carries the sixteen forms as printable pages at the back, and you also get the blank forms as separate files so you can print them or fill them in and send them to a workshop. Delivered by email within 24 hours of payment; updates free for the first twelve months.",
  },
  {
    q: "Does it include factory contacts or a supplier list?",
    a: "No. This is the rulebook, not a vendor list. Matched workshops are what the service tiers deliver — which is also why the handbook can be sold to anyone without giving away your suppliers.",
  },
  {
    q: "Can I get a refund?",
    a: "The handbook is a digital good, sold as final. Once the PDF has been emailed to you the sale is complete, and no refund or exchange is offered — which is why both sample sections are published in full on this page before you pay. If the file will not open, or the email never arrives, we resend or repair it within one working day. That is a delivery failure and it is covered, not a change of mind.",
  },
  {
    q: "How is this different from hiring you?",
    a: "The handbook teaches the rules. The service tiers apply them to your project: we shortlist, check the numbers, visit the workshop and put our name on the recommendation.",
  },
];
---
<BaseLayout title={title} description={description}>
  <Fragment slot="header">
    <Header />
  </Fragment>

  <div class="container page-guidebook" style="padding:2rem 1rem;">

    <!-- Availability notice: orders are handled by email until CHECKOUT_URL is filled in -->
    <p class="prelaunch">
      <span class="dot"></span><strong>Available now.</strong> English edition, 74 pages. Order by email, payment by card, PDF within 24 hours.
    </p>

    <!-- HERO -->
    <section class="hero" id="top">
      <div class="hero-copy">
        <p class="eyebrow">Sourcing Guidebook</p>
        <h1>The Dehua White Porcelain Sourcing Handbook</h1>
        <p class="lede">
          Everything a small overseas buyer needs to quote, sample, inspect and ship custom white porcelain from Dehua —
          written on the ground, in plain English, with the forms already made.
        </p>
        <div class="chips">
          <span class="chip">74 pages</span>
          <span class="chip">7 parts</span>
          <span class="chip">16 forms</span>
          <span class="chip">English edition</span>
        </div>
        <div class="hero-actions">
          <a class="btn-primary" href={ctaHref}>{ctaLabel}</a>
          <a class="btn-ghost" href="#sample">Read a free section</a>
        </div>
        <p class="price-line"><strong>$39.99</strong> one-time · PDF, 6 × 9 in · all sales final</p>
      </div>

      <div class="hero-visual">
        <div class="book-cover">
          <p class="cover-series">Dehua · Sourcing Series</p>
          <h2 class="cover-title">The Dehua White Porcelain Sourcing Handbook</h2>
          <div class="cover-rule"></div>
          <p class="cover-meta">Seven parts · sixteen forms<br />English edition · PDF</p>
          <p class="cover-price">$39.99</p>
        </div>
        <img class="cover-photo" src={coverImage} alt="Finished matte-glaze white porcelain pieces" />
      </div>
    </section>

    <!-- THREE THINGS -->
    <section class="block">
      <h2 class="block-title">The three things buyers lose money on</h2>
      <div class="loss-grid">
        <article class="loss-card">
          <h3>Who owns the mould you paid for</h3>
          <p>
            A paid mould is not automatically yours. The handbook separates the master model from the plaster
            working mould, and gives you the clause to sign before the mould fee leaves your account.
          </p>
        </article>
        <article class="loss-card">
          <h3>What is missing from the quotation</h3>
          <p>
            Local quotations usually arrive as one bundled number. The handbook gives you the breakdown order and the
            four extras that reappear on almost every quote in this county.
          </p>
          <a class="card-link" href="#sample">Part 2.5 is free below</a>
        </article>
        <article class="loss-card">
          <h3>Who decides what counts as a defect</h3>
          <p>
            Without a written grading standard, "handmade, small defects are normal" answers every complaint.
            A / B / C grading and the sampling rules settle it before the deposit.
          </p>
        </article>
      </div>
    </section>

    <!-- PHOTO STRIP -->
    <section class="strip-block">
      <div class="photo-strip">
        {photos.map((p) => (
          <figure class="photo-cell">
            <img src={p.src} alt={p.caption} />
            <figcaption>{p.caption}</figcaption>
          </figure>
        ))}
      </div>
      <p class="strip-note">The seven production steps, in the order they actually happen — Part 1.</p>
    </section>

    <!-- INSIDE -->
    <section class="block" id="inside">
      <h2 class="block-title">What is inside</h2>
      <p class="block-sub">Open any part to see what it covers.</p>
      <div class="inside-list">
        {parts.map((part) => (
          <details class="inside-item">
            <summary>
              <span class="inside-label">{part.label}</span>
              <span class="inside-summary">{part.summary}</span>
            </summary>
            <ul class="inside-points">
              {part.points.map((point) => <li>{point}</li>)}
            </ul>
          </details>
        ))}
      </div>
    </section>

    <!-- SAMPLE -->
    <section class="block" id="sample">
      <h2 class="block-title">One page, in full — no email needed</h2>
      <p class="block-sub">
        Part 2.5 is reproduced exactly as it appears in the book. The second free page, Part 4.3 on defect
        grading, is one click below.
      </p>

      <article class="page-sheet">
        <p class="sheet-runner">Part 2.5</p>
        <h3>Reading a quotation</h3>
        <p class="sheet-standfirst">A usable quotation itemises. A bundled number does not.</p>
        <p class="sheet-body">A quotation you can compare, line by line, separates:</p>
        <ul class="sheet-list">
          <li><strong>One-time tooling</strong> — modelling, master model printing, plaster working moulds.</li>
          <li><strong>Per piece</strong> — body, glaze, firing.</li>
          <li><strong>Surface work</strong> — laser engraving, decal, gilding, sanding.</li>
          <li><strong>Freight and packing</strong> — sample freight, bulk packing, tax or export paperwork.</li>
        </ul>
        <p class="sheet-body">
          Most workshops here quote one bundled figure. The minimum you should insist on is one-time tooling
          separated from per-piece cost.
        </p>
        <p class="sheet-body">Four extras that reappear on almost every quotation:</p>
        <ol class="sheet-list">
          <li><strong>Body only.</strong> Glaze and firing invoiced separately.</li>
          <li><strong>Plaster mould wear.</strong> Each working mould has a finite cycle count; re-moulding is a new charge — cheaper than a new master model, but not free.</li>
          <li><strong>Revisions.</strong> Free rounds are usually limited. The limit and the price of an extra round belong in the quote, not in a later message.</li>
          <li><strong>Packing upgrades.</strong> Inner tray, printed box, label — priced per unit, and easy to forget.</li>
        </ol>
        <p class="sheet-foot">
          Put three things in writing: how long the price holds, which processes are inside it, which are extra.
          A number without that sentence is not a quotation.
        </p>
        <p class="sheet-number">Sourcing Handbook · p.15</p>
      </article>

      <details class="second-sheet">
        <summary>Open the second free page — Part 4.3, grading a finished batch</summary>
        <div class="second-body">
          <p class="sheet-body"><strong>A — accept.</strong> Rests flat without wobble. Glaze clean at arm's length. Engraved lines continuous, no chipped edges. No crack, visible or hairline. Dimensions inside the agreed tolerance.</p>
          <p class="sheet-body"><strong>B — negotiate.</strong> Light colour variation, scattered pinholes or glaze bubbles, a slight wobble without toppling, a small loss of engraved detail. B grade is not automatically free: discount, rework, or replacement of the same quantity in A grade. Choose which one in the order, not after delivery.</p>
          <p class="sheet-body"><strong>C — reject.</strong> Visible or hairline cracks, warp, unstable centre of gravity, large bare patches, chipped corners, or a pattern materially different from the approved sample.</p>
          <p class="sheet-body"><strong>Sampling.</strong> Under 50 pieces — inspect all. 50 to 200 — 20%, minimum 10 pieces. Over 200 — 10%, minimum 40 pieces. If the defect rate exceeds the agreed limit, widen the sample or inspect everything before paying the balance.</p>
        </div>
      </details>
    </section>

    <!-- FORMS + MATH -->
    <section class="block" id="forms">
      <h2 class="block-title">Sixteen forms, already written</h2>
      <p class="block-sub">
        Print them, or fill them in and send them to a workshop as a PDF. Three prevent most of the disputes in
        this business: sample confirmation, mould ownership, inspection checklist.
      </p>
      <div class="form-tags">
        {forms.map((form) => <span class="form-tag">{form}</span>)}
      </div>

      <div class="math-row">
        <p><strong>What one wrong assumption costs.</strong> A master model re-opened after you approved the sample — tooling paid twice. A batch that fails the bar you agreed — rework, replacement or a discount, plus the shipping window. A mould you paid for and cannot take with you — the next order starts from zero.</p>
        <p class="math-note">No cost ranges are printed here. Those numbers belong in your factory's quotation.</p>
      </div>
    </section>

    <!-- TIERS -->
    <section class="block" id="tiers">
      <h2 class="block-title">How it sits next to the service tiers</h2>
      <p class="block-sub">The handbook teaches the rules. The tiers apply them to your project.</p>
      <div class="tier-grid">
        <a class="tier-card tier-card-book" href="#get">
          <p class="tier-name">Handbook</p>
          <p class="tier-price">$39.99</p>
          <p class="tier-text">The rules and the forms.</p>
        </a>
        <a class="tier-card" href="/supplier-development">
          <p class="tier-name">Basic</p>
          <p class="tier-price">$75</p>
          <p class="tier-text">Three matched workshops.</p>
        </a>
        <a class="tier-card" href="/supplier-development">
          <p class="tier-name">Standard</p>
          <p class="tier-price">$145</p>
          <p class="tier-text">Costs and qualification checked.</p>
        </a>
        <a class="tier-card" href="/supplier-development">
          <p class="tier-name">Premium</p>
          <p class="tier-price">$220</p>
          <p class="tier-text">On-site visit, two factories, 8-page report.</p>
        </a>
      </div>
      <p class="credit-line"><strong>Already bought the handbook?</strong> Within 30 days your price is Basic $55, Standard $117, Premium $180 — the higher the tier, the more of the book comes back. On Premium the book ends up free. One use, first service order only, not transferable. Quote your order ID from your purchase confirmation.</p>
    </section>

    <!-- AUTHOR + FAQ -->
    <section class="block">
      <div class="dual-grid">
        <div class="author-col">
          <h2 class="block-title">Written in Dehua, not about Dehua</h2>
          <p class="author-body">
            Every rule here came out of a workshop on this street. The author lives and works in Dehua, sourcing and
            developing white porcelain for overseas small buyers — 3D modelling, mould making, prototypes, small-batch
            trials and bulk orders — including the parts nobody writes down: which plaster mould is yours after you pay
            for it, and what a shared kiln does to your delivery date.
          </p>
        </div>
        <div class="faq-col">
          <h2 class="block-title">Before you pay</h2>
          <div class="faq-list">
            {faqs.map((f) => (
              <details class="faq-item">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ORDER -->
    <section class="final-cta" id="get">
      <h2>How to order</h2>
      <p class="final-sub">74 pages, 16 printable forms, two free sections above. One payment, no subscription.</p>
      <p class="final-price">$39.99</p>
      <ol class="order-steps">
        <li>Write to <a class="order-mail" href={ORDER_MAILTO}>hello@dehuasourcing.com</a> from the address you want the file sent to. Say you want the handbook and the link is filled in for you.</li>
        <li>Within a few hours — same day at the latest — you receive a PayPal request for $39.99 marked as a payment for goods. Pay with a card; you do not need a PayPal account.</li>
        <li>The PDF is emailed to you within 24 hours of payment. If it will not open, reply to the same email and it is resent the same working day.</li>
      </ol>
      <a class="btn-light" href={buyHref}>{ctaLabel}</a>
      <p class="final-note">
        Digital delivery, no physical shipment. All sales final once the file is sent — read the two free sections before ordering.
      </p>
    </section>

  </div>

  <!-- Mobile sticky buy bar -->
  <div class="sticky-buy">
    <div class="sticky-price"><strong>$39.99</strong><span>74 pages · 16 forms</span></div>
    <a class="btn-primary sticky-btn" href={ctaHref}>{ctaLabel}</a>
  </div>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</BaseLayout>

<style>
  .page-guidebook {
    --ink: #5c4838;
    --paper: #ffffff;
    --tint: #f8f5f0;
    --line: #d6cdc4;
  }

  .prelaunch {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.82rem;
    line-height: 1.5;
    color: #6b5d50;
    margin: 0 0 0.8rem 0;
  }

  .prelaunch .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #b84c3a;
    flex: 0 0 auto;
    position: relative;
    top: -2px;
  }

  /* ---------- HERO ---------- */
  .hero {
    background: var(--paper);
    padding: 2rem 2rem 1.8rem;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2rem;
    align-items: center;
  }

  .eyebrow {
    margin: 0 0 0.5rem 0;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.72rem;
    font-weight: 600;
    color: #8a7462;
  }

  .hero h1 {
    font-size: 1.95rem;
    line-height: 1.25;
    margin: 0 0 0.8rem 0;
    color: var(--ink);
  }

  .lede {
    font-size: 0.98rem;
    line-height: 1.68;
    margin: 0 0 1rem 0;
    color: #46403a;
    max-width: 46ch;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.1rem;
  }

  .chip {
    font-size: 0.76rem;
    padding: 0.24rem 0.55rem;
    border: 1px solid var(--line);
    background: var(--tint);
    color: #5c4838;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    margin-bottom: 0.8rem;
  }

  .btn-primary {
    display: inline-block;
    padding: 0.8rem 1.4rem;
    background: var(--ink);
    color: #ffffff;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.94rem;
    border: 1px solid var(--ink);
  }

  .btn-ghost {
    display: inline-block;
    padding: 0.8rem 1.2rem;
    background: transparent;
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.94rem;
    border: 1px solid var(--line);
  }

  .price-line {
    font-size: 0.84rem;
    color: #7a6a5c;
    margin: 0;
    line-height: 1.6;
  }

  .hero-visual {
    position: relative;
  }

  .book-cover {
    background: linear-gradient(160deg, #6b5342 0%, #5c4838 100%);
    color: #f7f1e9;
    padding: 1.8rem 1.5rem;
    box-shadow: 0 18px 38px rgba(60, 42, 28, 0.28);
    position: relative;
    z-index: 2;
  }

  .cover-series {
    margin: 0 0 1.6rem 0;
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #d8c7b4;
  }

  .cover-title {
    font-size: 1.22rem;
    line-height: 1.34;
    margin: 0 0 1rem 0;
    font-weight: 600;
  }

  .cover-rule {
    width: 40px;
    height: 2px;
    background: #c9b59c;
    margin-bottom: 1rem;
  }

  .cover-meta {
    margin: 0 0 1.4rem 0;
    font-size: 0.78rem;
    line-height: 1.65;
    color: #d8c7b4;
  }

  .cover-price {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 600;
  }

  .cover-photo {
    width: 74%;
    display: block;
    margin: -1.8rem 0 0 auto;
    position: relative;
    z-index: 1;
    box-shadow: 0 12px 26px rgba(60, 42, 28, 0.18);
  }

  /* ---------- 通用块 ---------- */
  .block {
    background: var(--paper);
    padding: 1.8rem 1.8rem;
    margin-top: 1rem;
  }

  .block-title {
    font-size: 1.32rem;
    margin: 0 0 0.55rem 0;
    color: var(--ink);
    line-height: 1.35;
  }

  .block-sub {
    margin: 0 0 1.1rem 0;
    color: #6b5d50;
    font-size: 0.92rem;
    line-height: 1.65;
    max-width: 62ch;
  }

  /* ---------- 三个亏钱点 ---------- */
  .loss-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
    margin-top: 1rem;
  }

  .loss-card {
    border-top: 2px solid var(--ink);
    padding-top: 0.9rem;
  }

  .loss-card h3 {
    font-size: 1rem;
    margin: 0 0 0.5rem 0;
    line-height: 1.4;
  }

  .loss-card p {
    font-size: 0.89rem;
    line-height: 1.65;
    margin: 0 0 0.5rem 0;
    color: #4b4239;
  }

  .card-link {
    color: var(--ink);
    font-weight: 500;
    font-size: 0.86rem;
    text-decoration: underline;
  }

  /* ---------- 工艺横条 ---------- */
  .strip-block {
    margin-top: 1rem;
  }

